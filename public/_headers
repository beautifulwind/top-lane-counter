# Cloudflare Pages 응답 헤더
# 서비스 워커·진입 파일은 오래 저장되지 않게 (새 버전을 바로 알아채도록 매번 재확인)
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/offline.html
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
# 파일 이름에 해시가 붙은 화면 파일은 오래 저장
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=86400
# 앱 업데이트 안내(1.3 패치 1-F, SPEC 6-99): 앱(capacitor://localhost 등)이 읽을 수 있게 CORS 허용, 항상 최신 값을 읽도록 캐시 금지
/version.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache, no-store, must-revalidate
